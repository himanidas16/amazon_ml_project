# ---------------------------------------------------------------------------
# Competition data -- NEVER commit.
# Two independent reasons:
#   1. Every .tsv is 121-486 MB; GitHub hard-rejects any file over 100 MB.
#   2. It is the organizers' data. Each teammate downloads it themselves from
#      the challenge portal. Re-hosting it is not ours to do.
# ---------------------------------------------------------------------------
amazon_ml_dataset/
student_resource/
dataset/
*.tsv

# ---------------------------------------------------------------------------
# Pipeline outputs -- regenerated by code, and too big for git.
# matching_results.tsv for 1.73M test rows is well over 100 MB on its own.
# ---------------------------------------------------------------------------
output/
artifacts/
*_submission.zip

# Cached intermediates (feature matrices, blocking indexes, models)
cache/
*.pkl
*.joblib
*.npy
*.npz
*.parquet
*.feather
*.txt.gz
*.lgb
*.model

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Editors / OS junk (this dataset zip arrived with __MACOSX in it)
# ---------------------------------------------------------------------------
.DS_Store
__MACOSX/
._*
.vscode/
.idea/
*.swp

# organizer query form: contains other participants' personal data
*.xlsx

# archives prepared for teammates (large, contain competition data)
share_for_team/
output_v*/
